# Copy to .env. Never commit credentials or private keys.
SNOWFLAKE_ACCOUNT=YOUR_ORGANIZATION-YOUR_ACCOUNT
SNOWFLAKE_USER=YOUR_LOGIN_NAME
SNOWFLAKE_ROLE=DATAMIND_READER
SNOWFLAKE_WAREHOUSE=SNOWFLAKE_LEARNING_WH
SNOWFLAKE_DATABASE=SNOWFLAKE_SAMPLE_DATA
SNOWFLAKE_SCHEMA=TPCH_SF1
SNOWFLAKE_PRIVATE_KEY_PATH=~/.snowflake/datamind_key.p8
# Leave the passphrase out: python run.py prompts securely at startup.
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=gemma3:12b
OLLAMA_TIMEOUT_SECONDS=180
# Optional: JSON list of additional trusted dataset config paths.
# Defaults to the included uci_wine_quality.json alongside the primary TPC-H config.
# ADDITIONAL_DATASET_PATHS=["/absolute/path/to/dataset.json"]
QUERY_TIMEOUT_SECONDS=30
CORS_ORIGINS=["http://localhost:3000","http://localhost:5173"]
# Optional for local use; clients then send X-API-Key with this value.
API_KEY=
