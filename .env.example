# Copy to .env and fill in. Never commit .env.
DATAMIND_DATASET=tpch
DATAMIND_LLM_BACKEND=ai_studio

# Gemma 4 via Gemini API (free key: https://aistudio.google.com/apikey)
GOOGLE_API_KEY=
AI_STUDIO_MODEL=gemma-4-26b-a4b-it

# Optional local Gemma via Ollama
OLLAMA_MODEL=gemma4:e4b
OLLAMA_HOST=http://localhost:11434

# Snowflake (account format: orgname-accountname)
SNOWFLAKE_ACCOUNT=
SNOWFLAKE_USER=DATAMIND_APP
SNOWFLAKE_PASSWORD=
SNOWFLAKE_ROLE=DATAMIND_READER
SNOWFLAKE_WAREHOUSE=DATAMIND_WH
