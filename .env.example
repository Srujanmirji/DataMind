# Copy to .env and fill in. .env is git-ignored. Never commit real values.

# --- Snowflake (key-pair auth recommended; password shown for trial accounts) ---
SNOWFLAKE_ACCOUNT=myorg-myaccount
SNOWFLAKE_USER=DATAMIND_APP
SNOWFLAKE_PASSWORD=
# SNOWFLAKE_PRIVATE_KEY_PATH=/path/to/rsa_key.p8
SNOWFLAKE_ROLE=DATAMIND_READER
SNOWFLAKE_WAREHOUSE=DATAMIND_WH

# --- Dataset: any file under config/datasets/ (without .yaml) ---
DATAMIND_DATASET=tpch

# --- Gemma 4 backend: "ai_studio" (hosted, default) or "ollama" (local fallback) ---
DATAMIND_LLM_BACKEND=ai_studio

# Google AI Studio / Gemini API. Free key: https://aistudio.google.com/apikey
# Model id as used in Google's Gemma-on-Gemini-API docs; confirm in AI Studio's model list.
GOOGLE_API_KEY=
AI_STUDIO_MODEL=gemma-4-26b-a4b-it

# Optional local fallback. Pull first: ollama pull gemma4:e4b
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=gemma4:e4b
